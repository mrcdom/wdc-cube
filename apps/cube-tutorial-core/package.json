{
  "name": "wdc-cube-tutorial-core",
  "version": "1.1.0",
  "description": "View-agnostic half of the tutorial: places, keys, presenters, scopes and services. Depends on wdc-cube only.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/modules/main/index.ts",
    "./todo-mvc": "./src/modules/todo-mvc/index.ts",
    "./subscriptions": "./src/modules/subscriptions/index.ts",
    "./restricted": "./src/modules/restricted/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "wdc-cube": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
