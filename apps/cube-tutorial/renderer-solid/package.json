{
  "name": "wdc-cube-tutorial-renderer-solid",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "SolidJS view layer for the tutorial: fine-grained reactivity over the same presentation.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
