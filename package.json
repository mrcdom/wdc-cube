{
  "name": "cube-workspaces",
  "private": true,
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "scripts": {
    "clean": "rimraf \"{libs,apps}/**/{lib,coverage,dist,build,*.tsbuildinfo,.scannerwork,junit.xml,test-report.xml}\"",
    "compile": "tsc -b tsconfig.build.json",
    "build": "pnpm run compile && pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "start": "pnpm --filter wdc-cube-tutorial run start",
    "format": "prettier --write \"*.{ts,tsx,js,md,yml,json}\" \"libs/*/src/**/*.{ts,tsx,yml}\" \"apps/*/src/**/*.{ts,tsx,yml}\"",
    "format:check": "prettier --check \"*.{ts,tsx,js,md,yml,json}\" \"libs/*/src/**/*.{ts,tsx,yml}\" \"apps/*/src/**/*.{ts,tsx,yml}\"",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.15.29",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0"
  }
}
