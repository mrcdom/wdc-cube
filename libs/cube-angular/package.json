{
  "name": "wdc-cube-angular",
  "version": "1.3.0",
  "description": "Angular bindings for the Cube architecture",
  "author": "Marcelo Domingos <mrcdom@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcdom/wdc-cube.git",
    "directory": "libs/cube-angular"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepack": "node ../../scripts/sync-license.mjs && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/require-pnpm.mjs",
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "compile": "ng-packagr -p ng-package.json -c tsconfig.lib.json"
  },
  "peerDependencies": {
    "wdc-cube": "workspace:^",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "rxjs": "^7.8.2",
    "vitest": "^5.0.0",
    "wdc-cube": "workspace:*",
    "zone.js": "~0.16.0"
  },
  "homepage": "https://github.com/mrcdom/wdc-cube/tree/master/libs/cube-angular#readme",
  "bugs": {
    "url": "https://github.com/mrcdom/wdc-cube/issues"
  },
  "keywords": [
    "cube",
    "wdc-cube",
    "angular",
    "presenter",
    "binding"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "directory": "dist"
  }
}
