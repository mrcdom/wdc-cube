{
  "name": "wdc-cube-angular",
  "version": "1.2.1",
  "description": "Angular bindings for the Cube architecture",
  "author": "Marcelo Domingos <mrcdom@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcdom/wdc-cube.git",
    "directory": "libs/cube-angular"
  },
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "prepack": "tsc --noEmit && node ../../scripts/sync-license.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/require-pnpm.mjs"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0"
  },
  "dependencies": {
    "wdc-cube": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "jsdom": "^30.0.1",
    "rxjs": "^7.8.2",
    "vitest": "^5.0.0",
    "zone.js": "~0.16.0"
  },
  "homepage": "https://github.com/mrcdom/wdc-cube/tree/master/libs/cube-angular#readme",
  "bugs": {
    "url": "https://github.com/mrcdom/wdc-cube/issues"
  },
  "keywords": [
    "cube",
    "wdc-cube",
    "angular",
    "presenter",
    "binding"
  ],
  "engines": {
    "node": ">=20.19.0"
  }
}
