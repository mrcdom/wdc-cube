{
  "name": "wdc-cube",
  "version": "1.4.0",
  "description": "Cube architecture core - presenter/scope/place navigation framework",
  "author": "Marcelo Domingos <mrcdom@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcdom/wdc-cube.git",
    "directory": "libs/cube"
  },
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./codec": {
      "types": "./lib/codec/index.d.ts",
      "default": "./lib/codec/index.js"
    }
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/sync-license.mjs",
    "compile": "tsc -b",
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "history": "^5.3.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@noble/ciphers": "^2.4.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/mrcdom/wdc-cube/tree/master/libs/cube#readme",
  "bugs": {
    "url": "https://github.com/mrcdom/wdc-cube/issues"
  },
  "keywords": [
    "cube",
    "architecture",
    "presenter",
    "mvp",
    "routing",
    "spa",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@noble/ciphers": "^2.4.0",
    "fflate": "^0.8.3"
  },
  "peerDependenciesMeta": {
    "@noble/ciphers": {
      "optional": true
    },
    "fflate": {
      "optional": true
    }
  }
}
