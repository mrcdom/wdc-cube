{
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 120,
  "useTabs": false,
  "semi": false,
  "tabWidth": 4,
  "overrides": [
    {
      "files": ["*.yml", "*.yaml", "*.md"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.json"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    }
  ]
}
